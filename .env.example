# Postgres
USER=postgres
PASSWORD=your_postgres_password
HOST=localhost
PORT=5432
DBNAME=regmind

# Encrypts the agents' Switch API keys. Any long random string.
# Don't change it after running /switch/provision.
SECRET_KEY=change-me-to-a-long-random-string

# Gemini (get a key at https://aistudio.google.com/apikey)
GOOGLE_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.5-flash-lite

# Switch server (Railway "Agent Switch" template) and its admin login
SWITCH_URL=https://switch-production-xxxx.up.railway.app
SWITCH_EMAIL=admin@example.com
SWITCH_PASSWORD=your_switch_admin_password
SWITCH_AUTOCONNECT=true

# GitHub repo the auditor reads pull requests from
GITHUB_REPO=AnshuRoy25/regmind-demo-broker
# Optional for public repos
GITHUB_TOKEN=